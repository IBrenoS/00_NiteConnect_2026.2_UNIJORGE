# SOMENTE para desenvolvimento local; não reutilize em produção.
DB_NAME=niteconnect
DB_USERNAME=niteconnect
DB_PASSWORD=trocar_antes_de_usar
DB_PORT=5432

# Validação de tokens emitidos pelo Microsoft Entra na API.
# Preencha os valores do tenant e da exposição da API para habilitar o login.
ENTRA_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=
ENTRA_REQUIRED_SCOPE=access_as_user

# Bloco 05.1 — ativação SOMENTE durante os testes locais
DOCUMENTS_ENABLED=false
DOCUMENTS_ALLOW_INSECURE_DEV=false
DOCUMENTS_WOPI_PUBLIC_BASE_URL=http://host.docker.internal:8080
COLLABORA_DISCOVERY_URL=http://localhost:9980/hosting/discovery
DOCUMENT_STORAGE_PROVIDER=disabled
DOCUMENT_S3_ENDPOINT=http://127.0.0.1:8333
DOCUMENT_S3_BUCKET=nite-connect-documents
DOCUMENT_S3_REGION=us-east-1
# Defina os dois segredos exclusivamente no .env não versionado
DOCUMENT_S3_ACCESS_KEY=
DOCUMENT_S3_SECRET_KEY=
